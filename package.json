{
  "name": "pstack-dsh",
  "version": "0.2.4-dsh.1",
  "private": true,
  "type": "module",
  "description": "pstack for DeepSeek Harness: per-role model routing that reads the live harness catalog instead of a vendor list.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "agents",
    "overrides",
    "cordis.patch.yml",
    "scripts",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test": "node tests/run.mjs",
    "test:keep": "node tests/run.mjs --no-deploy",
    "test:live": "node tests/run.mjs --no-deploy --live",
    "sync-skills": "python sync-skills.py",
    "capture-seam": "python capture-seam.py",
    "check-upstream": "node scripts/check-upstream.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "react": { "optional": true }
  }
}
